NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=yawadb

KEYCLOAK_DB_PASSWORD=secure_keycloak_db_password
KEYCLOAK_ADMIN_PASSWORD=secure_keycloak_admin_password
KEYCLOAK_REALM=yawa
KEYCLOAK_CLIENT_ID=yawa-app
KEYCLOAK_CLIENT_SECRET=super-secret

APP_DOMAIN=yawa.polysim.work
NEXTAUTH_URL=https://${APP_DOMAIN}
NEXTAUTH_SECRET=super-secret
PAT_TOKEN_PEPPER=secure_pat_token_pepper
KEYCLOAK_DOMAIN=yawa-auth.polysim.work
KEYCLOAK_ISSUER=https://${KEYCLOAK_DOMAIN}/realms/${KEYCLOAK_REALM}
NEXT_PUBLIC_API_BASE_URL=https://${APP_DOMAIN}/api/trpc

## Optional: Bind to a different port. Uncomment and adjust the values below.
# CADDY_HTTP_BIND=127.0.0.1:8080:80
# CADDY_HTTPS_BIND=127.0.0.1:8443:443

LOG_LEVEL=warn
