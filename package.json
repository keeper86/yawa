{
    "name": "yawa",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev:only": "next dev --turbopack",
        "dev": "npm run db:migrate:latest && npm run db:seed && npm run db:types:update && next dev --turbopack",
        "build": "next build",
        "start": "echo 'Use docker compose for production. For local standalone testing (replace db credentials): DATABASE_URL=postgresql://user:pass@localhost:5432/db node .next/standalone/server.js' && exit 1",
        "start:standalone": "node --env-file=.env .next/standalone/server.js",
        "lint:check": "eslint .",
        "lint": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:file": "prettier --write",
        "test": "npm run test:unit && npm run test:server",
        "test:unit": "vitest --run",
        "test:server": "vitest --run --config vitest.server.config.ts",
        "test:unit:watch": "vitest --watch",
        "test:server:watch": "vitest --watch --config vitest.server.config.ts",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:all": "npm run format && npm run lint && npx tsc && npm run test",
        "db:migrate:make": "npx knex migrate:make",
        "db:migrate:latest": "npx knex migrate:latest",
        "db:migrate:rollback": "npx knex migrate:rollback",
        "db:seed": "knex seed:run --env development",
        "db:seed:corpus": "NODE_ENV=development tsx tools/seed_corpus.ts",
        "db:types:check": "node ./tools/db_types.cjs check",
        "db:types:update": "node ./tools/db_types.cjs update",
        "i18n:scan": "node ./tools/i18n_scan.cjs && node ./tools/i18n_scan_literals.cjs",
        "db:waitFor": "npx wait-on --timeout=60000 tcp:localhost:5432",
        "generate-keycloak-realm": "set -a && . ./.env && set +a && envsubst < ./keycloak/data/template.json > ./keycloak/data/import/initialRealm.json"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.90.2",
        "@trpc/client": "^11.5.1",
        "@trpc/server": "^11.5.1",
        "@trpc/tanstack-react-query": "^11.6.0",
        "@vitejs/plugin-react": "^4.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "daisyui": "^5.1.6",
        "dotenv": "^17.2.2",
        "dotenv-expand": "^12.0.3",
        "embla-carousel-react": "^8.6.0",
        "knex": "^3.1.0",
        "knex-types": "^0.5.0",
        "lucide-react": "^0.544.0",
        "next": "^16.4.3",
        "next-auth": "^4.24.11",
        "next-intl": "^4.14.7",
        "next-themes": "^0.4.6",
        "pg": "^8.16.3",
        "pino": "^9.10.0",
        "pino-pretty": "^13.1.1",
        "postcss": "^8.5.6",
        "prettier": "^3.5.3",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "react-joyride": "^3.1.0",
        "recharts": "^2.6.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "trpc-to-openapi": "^3.0.1",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.42.0",
        "zod": "^4.1.9"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@eslint/js": "^9.35.0",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/postcss": "^4",
        "@testcontainers/postgresql": "^12.2.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@tsconfig/next": "^2.0.3",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^9.34.0",
        "eslint-config-next": "^16.4.0",
        "globals": "^14.0.0",
        "jsdom": "^26.1.0",
        "nextjs-routes": "^2.2.5",
        "tailwindcss": "^4.1.13",
        "typescript": "^5",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.3",
        "wait-on": "^9.0.1"
    },
    "overrides": {
        "trpc-to-openapi": {
            "@rollup/rollup-linux-x64-gnu": "4.64.5"
        }
    }
}
