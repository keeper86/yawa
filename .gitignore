# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
node-ramp-*.json

# benchmarks
**/results/**/*
/tools/longrun/results/**/*

# snapshot / compressed artifacts
*.snapshot
*.gz


# playwright
/test-results/
/playwright-report/
/playwright/.cache/
playwright/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# scratch notes / misc text
*.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/debug/

# env files (can opt-in for committing if needed)
.env*
!.env.example*

# Intellij
/.idea
*.iml

# typescript
*.tsbuildinfo
next-env.d.ts

# plantuml
plantuml*.jar

.vscode
